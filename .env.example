# Modal credentials
# Usually created by `modal setup` and stored in Modal's config directory.
# If the comfy-gen process cannot see that profile, you can set tokens here.
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...
# MODAL_PROFILE=default

# Modal resource names
COMFY_GEN_MODAL_APP_NAME=comfy-gen
COMFY_GEN_MODAL_VOLUME_NAME=comfy-gen-comfyui
COMFY_GEN_MODAL_SECRET_NAME=comfy-gen-storage
COMFY_GEN_MODAL_JOBS_NAME=comfy-gen-jobs
COMFY_GEN_MODAL_FUNCTION_NAME=run_job

# S3-compatible storage (AWS, Cloudflare R2, Backblaze B2, MinIO, etc.)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_REGION=us-east-1
S3_BUCKET=my-comfy-bucket

# Optional: custom S3 endpoint for R2/B2/MinIO/etc.
# S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Optional: CivitAI token for model downloads
# CIVITAI_TOKEN=...

# Runtime tuning
# COMFY_GEN_TIMEOUT=1200
# COMFY_GEN_POLL_INTERVAL=3
